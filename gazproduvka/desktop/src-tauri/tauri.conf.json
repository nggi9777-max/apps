{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GazProduvka",
  "mainBinaryName": "GazProduvka",
  "version": "2.2.0",
  "identifier": "uz.uzbekneftegaz.gazproduvka",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ГазПродувка — мониторинг и оптимизация продувок газовых скважин",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "publisher": "Uzbekneftegaz",
    "shortDescription": "Мониторинг и оптимизация продувок газовых скважин",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 620,
          "height": 380
        }
      }
    }
  }
}